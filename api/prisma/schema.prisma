// ESQUEMA DE DATOS DE DCREDITS
//
// Cadena: PostgreSQL -> Prisma -> NestJS API
//
// Reglas del dominio:
//  - Student solo guarda datos permanentes del estudiante.
//  - Todo lo que depende de un evento (creditos, nota, tipo de participacion,
//    codigo de certificado y codigo DCredits) vive en Participation.
//  - Los creditos acumulados NO se almacenan: se derivan de las participaciones
//    vigentes (status = VALID).
//  - verificationCode es unico y estable: se genera una vez y nunca cambia.
//
// Documentacion del schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUMERACIONES
// ---------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  INACTIVE
}

/// SINGLE_DAY: un solo dia. MULTI_DAY: spanning de varios dias.
enum EventType {
  SINGLE_DAY
  MULTI_DAY
}

enum EventModality {
  PRESENTIAL
  VIRTUAL
  HYBRID

  /// Sin valor conocido (registros historicos). La interfaz muestra "No especificado".
  UNSPECIFIED
}

enum EventStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Procedencia de un evento.
/// CURRENT: creado en DCredits con sus datos completos.
/// LEGACY: data historica migrada; admite campos opcionales con valores por defecto.
enum EventOrigin {
  CURRENT
  LEGACY
}

/// Precision de la fecha del evento.
/// LONG: dia, mes y anio. SHORT: solo mes y anio.
enum EventDateType {
  LONG
  SHORT
}

/// VALID es la unica que suma creditos al historial del estudiante.
enum ParticipationStatus {
  VALID
  CANCELLED
  PENDING
}

/// Procedencia de una participacion.
/// CURRENT: registrada en DCredits; el codigo de verificacion lo genera el sistema.
/// LEGACY: data historica migrada; conserva el codigo de verificacion original.
enum ParticipationOrigin {
  CURRENT
  LEGACY
}

/// Estado de las tablas de catalogo (escuelas, sedes y organizadores).
enum CatalogStatus {
  ACTIVE
  INACTIVE
}

/// Perfil funcional de quien opera DCredits.
/// ORGANIZER = organizador de la escuela, OPERATOR = operador de registro.
enum UserRole {
  ADMIN
  COORDINATOR
  ORGANIZER
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Nivel de acceso de un usuario a un modulo.
/// NONE: sin acceso. VIEW: solo consulta. MANAGE: crea, edita y elimina.
enum PermissionLevel {
  NONE
  VIEW
  MANAGE
}

// ---------------------------------------------------------------------------
// CATALOGOS
// ---------------------------------------------------------------------------

/// Escuela profesional. `general` es el identificador de las cuentas globales:
/// no representa una escuela real y no se ofrece en los formularios de
/// estudiantes, eventos ni participaciones.
model ProfessionalSchool {
  id   Int           @id @default(autoincrement())
  name String        @unique @db.VarChar(150)
  status CatalogStatus @default(ACTIVE)

  users    User[]
  students Student[]
  events   Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("professional_schools")
}

/// Sede o filial de la institucion. Se usa en el padron de estudiantes.
model Location {
  id   Int           @id @default(autoincrement())
  name String        @unique @db.VarChar(150)
  status CatalogStatus @default(ACTIVE)

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("locations")
}

/// Area o dependencia que organiza eventos academicos.
model Organizer {
  id   Int           @id @default(autoincrement())
  name String        @unique @db.VarChar(150)
  status CatalogStatus @default(ACTIVE)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("organizers")
}

/// Tipo de evento academico (congreso, seminario, taller, ...).
/// El nombre se guarda en ingles; la interfaz lo traduce al espanol.
model EventTypeCatalog {
  id     Int           @id @default(autoincrement())
  name   String        @unique @db.VarChar(100)
  status CatalogStatus @default(ACTIVE)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("event_types")
}

// ---------------------------------------------------------------------------
// ENTIDADES
// ---------------------------------------------------------------------------

/// Padron maestro de estudiantes.
/// No contiene creditos, notas, participaciones ni codigos: eso es de Participation.
model Student {
  id Int @id @default(autoincrement())

  /// Codigo universitario. Identificador funcional y unico.
  universityCode String @unique

  lastName  String
  firstName String

  /// Escuela profesional y sede del estudiante. Obligatorias: el padron no
  /// admite estudiantes sin adscripcion.
  professionalSchoolId Int
  professionalSchool   ProfessionalSchool @relation(fields: [professionalSchoolId], references: [id], onDelete: Restrict)
  locationId           Int
  location             Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  status StudentStatus @default(ACTIVE)

  participations Participation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalSchoolId])
  @@index([locationId])
  @@index([status])
  @@map("students")
}

/// Evento academico. Los creditos son los que otorga a cada participante.
model Event {
  id Int @id @default(autoincrement())

  /// Codigo institucional del evento, por ejemplo "EVT-2026-001".
  code String @unique

  name        String
  description String @default("Sin descripción")

  /// SINGLE_DAY / MULTI_DAY: se deriva de startDate y endDate, no se elige a mano.
  /// La columna se llama duration_type.
  durationType EventType @default(SINGLE_DAY) @map("duration_type")

  /// Tipo academico del evento (congreso, seminario, taller, ...).
  eventTypeId Int
  eventTypeCatalog EventTypeCatalog @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)

  /// Fechas calendario del evento (solo dia, sin hora). No se impone limite
  /// artificial de dias: la unica regla es endDate >= startDate.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// Precision de las fechas: completa (dia/mes/anio) o solo mes/anio.
  dateType EventDateType @default(LONG) @map("date_type")

  modality EventModality @default(PRESENTIAL)

  /// Lugar fisico del evento (auditorio, aula, campus). No es la sede del
  /// estudiante: esa vive en Location y solo aplica al padron.
  location String @default("Sin ubicación")
  capacity Int @default(0)

  /// Procedencia del registro: actual o historico.
  origin EventOrigin @default(CURRENT)

  /// Organizador y escuela a la que pertenece el evento. La escuela acota lo
  /// que cada usuario puede ver y modificar.
  organizerId Int
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  professionalSchoolId Int
  professionalSchool   ProfessionalSchool @relation(fields: [professionalSchoolId], references: [id], onDelete: Restrict)

  /// Creditos que otorga el evento. Entre 0 y 21 (0 es valido).
  credits Float @default(1)

  status EventStatus @default(DRAFT)

  /// Nombre completo del usuario que creo el evento y del ultimo que lo
  /// modifico. Los estampa el backend a partir del actor de la peticion.
  userCreate String @default("")
  userUpdate String @default("")

  participations Participation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([status])
  @@index([origin])
  @@index([organizerId])
  @@index([professionalSchoolId])
  @@index([eventTypeId])
  @@map("events")
}

/// Relacion Evento <-> Estudiante.
///
/// Unico por evento: eventId + studentId impide registrar dos veces al mismo
/// estudiante en el mismo evento.
model Participation {
  id Int @id @default(autoincrement())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int

  participationDate DateTime

  /// Creditos otorgados por ESTA participacion. Nunca negativo.
  credits Float @default(0)

  /// Codigo unico de verificacion.
  /// En registros CURRENT lo genera DCredits ("DC-2026-8F4K2P").
  /// En registros LEGACY es el codigo original de la data historica y se
  /// conserva tal cual, sin convertirlo al formato de DCredits.
  verificationCode String @unique

  /// Distingue un registro actual de uno historico migrado.
  origin ParticipationOrigin @default(CURRENT)

  /// Nota como texto: "sin nota" o un valor numerico entre 0 y 20.
  grade String @default("sin nota") @db.VarChar(10)

  status ParticipationStatus @default(VALID)

  /// Nombre del usuario que creo la participacion y del ultimo que la modifico.
  /// Igual que en Event: los estampa el backend a partir del actor de la peticion.
  /// El valor por defecto evita autores vacios en cargas antiguas o directas.
  userCreate String @default("Usuario 1")
  userUpdate String @default("Usuario 1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, studentId])
  @@index([studentId])
  @@index([status])
  @@index([origin])
  @@map("participations")
}

/// Usuarios que operan DCredits: administracion, organizadores y operadores de
/// registro. Cada escuela profesional tiene al menos un organizador y un
/// operador.
///
/// La contraseña NUNCA se guarda en claro: `passwordHash` es un hash scrypt con
/// sal por usuario. `mustChangePassword` queda en true para las cuentas
/// sembradas con contraseña temporal, hasta que exista el cambio de contraseña.
model User {
  id Int @id @default(autoincrement())

  fullName String
  email    String @unique

  /// Hash scrypt en formato "scrypt$<salHex>$<hashHex>". Nunca la contraseña.
  passwordHash String

  /// true mientras la cuenta siga con la contraseña temporal.
  mustChangePassword Boolean @default(true)

  role   UserRole   @default(VIEWER)
  status UserStatus @default(ACTIVE)

  /// Escuela profesional de la que depende el usuario. La escuela llamada
  /// `general` identifica a las cuentas globales: pueden operar sobre todas.
  professionalSchoolId Int
  professionalSchool   ProfessionalSchool @relation(fields: [professionalSchoolId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Permisos por modulo. Cada usuario tiene su propia matriz, aunque comparta
  /// rol con otras personas.
  permissions UserModulePermission[]

  @@index([role])
  @@index([professionalSchoolId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// MODULOS Y PERMISOS
// ---------------------------------------------------------------------------

/// Catalogo de modulos del sistema. `name` es el identificador estable que usa
/// el frontend (dashboard, calendar, events, ...).
model Module {
  id   Int    @id @default(autoincrement())
  name String @unique

  permissions UserModulePermission[]

  @@map("modules")
}

/// Matriz de permisos: que puede hacer un usuario en cada modulo.
/// La clave compuesta impide dos filas para el mismo usuario y modulo.
model UserModulePermission {
  userId     Int
  moduleId   Int
  permission PermissionLevel

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([moduleId])
  @@map("user_module_permissions")
}
